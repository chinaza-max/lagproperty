						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"Fraudulent property listing and invalid identity verification documents submitted.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/agents/5/blacklist",
							"host": ["{{baseUrl}}"],

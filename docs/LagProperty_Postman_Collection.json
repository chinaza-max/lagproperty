{
	"info": {
		"_postman_id": "lagproperty-api-collection-v1",
		"name": "LagProperty API & Analytics Dashboard Collection",
		"description": "Complete Postman documentation for LagProperty Backend APIs including Authentication, User Operations, Property Management, Analytics Dashboard (NIN transaction lookup, location housing stats), Admin Role-Based Access Control (RBAC), Agent Blacklisting, and Admin User/Building/Review Directory APIs.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication & Public APIs",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"emailAddress\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"type\": \"rent\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/registerUser",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "registerUser"]
						},
						"description": "Register a new tenant or property manager account."
					}
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailAddress\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"type\": \"rent\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/loginUser",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "loginUser"]
						},
						"description": "Authenticate user and receive access token."
					}
				},
				{
					"name": "Send Verification Code",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": 1,\n  \"validateFor\": \"rent\",\n  \"type\": \"email\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/sendVerificationCodeEmailOrTel",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "sendVerificationCodeEmailOrTel"]
						}
					}
				},
				{
					"name": "Verify Email, Phone, or NIN",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"verificationCode\": 123456,\n  \"validateFor\": \"rent\",\n  \"type\": \"email\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verifyEmailorTel",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "verifyEmailorTel"]
						}
					}
				},
				{
					"name": "Validate Bank Account",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"bankCode\": \"058\",\n  \"accountNumber\": \"0123456789\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/validateBankAccount",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "validateBankAccount"]
						}
					}
				}
			]
		},
		{
			"name": "Analytics Dashboard",
			"item": [
				{
					"name": "User Transactions by NIN (Spent / Received)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/analytics/nin-transactions?nin=12345678901&userType=tenant&page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["analytics", "nin-transactions"],
							"query": [
								{
									"key": "nin",
									"value": "12345678901"
								},
								{
									"key": "userType",
									"value": "tenant"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					}
				},

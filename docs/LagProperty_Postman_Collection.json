		{
			"name": "Admin User & Property Management Directory (Grouped APIs)",
			"item": [
				{
					"name": "Get All Tenants (Paginated & Filterable)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/users/tenants?page=1&limit=10&search=",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "users", "tenants"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "search",
									"value": ""
								}
							]
						},
						"description": "Lists all prospective tenants and active tenants with rental history summary."
					}
				},
				{
					"name": "Get All Landlords & Agents (Paginated & Filterable)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/users/landlords-agents?type=landLord&page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "users", "landlords-agents"],
							"query": [
								{
									"key": "type",
									"value": "landLord",
									"description": "landLord, agent, or unset"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Lists all landlords and agents with property listing counts (vacant, occupied, booked)."
					}
				},
				{
					"name": "Get Single Tenant Full Details (Rentals, Transactions, Reviews)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/users/tenant-details/1",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "users", "tenant-details", "1"]
						},
						"description": "Detailed tenant view including houses rented, inspections, reviews, and transaction history."
					}
				},
				{
					"name": "Get Single Landlord/Agent Full Details (Listed Houses, Availability, Reviews)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/users/manager-details/1",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "users", "manager-details", "1"]
						},
						"description": "Detailed view of landlord or agent including all listed houses/buildings, vacant/occupied availability status, and tenant reviews."
					}
				},
				{
					"name": "Get All Listed Buildings / Houses Directory",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/buildings/all?availability=vacant&page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "buildings", "all"],
							"query": [
								{
									"key": "availability",
									"value": "vacant",
									"description": "vacant, occupied, or booked"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Directory of all buildings and houses listed on the platform with availability filters and owner details."
					}
				},
				{
					"name": "Get Building / House Full Details & Reviews",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/buildings/1/details",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "buildings", "1", "details"]
						},
						"description": "Detailed view of a building including owner details, current occupants, inspection history, and all tenant reviews/ratings."
					}
				}
			]
		},
		{
			"name": "Admin RBAC & Account Management",
			"item": [
				{
					"name": "Create Admin Account",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailAddress\": \"finance.admin@lagproperty.com\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"Finance\",\n  \"lastName\": \"Manager\",\n  \"role\": \"finance_admin\",\n  \"privilege\": \"financial_analytics,transactions,escrow\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/create",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "create"]
						}
					}
				},
				{
					"name": "Get All Admins (Paginated)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/list?page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "list"]
						}
					}
				},
				{
					"name": "Update Admin Role & Privileges",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"compliance_admin\",\n  \"privilege\": \"agent_blacklist,nin_lookup\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/1/role",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "1", "role"]
						}
					}
				},
				{
					"name": "Toggle Admin Account Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"disableAccount\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/1/status",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "1", "status"]
						}
					}
				}
			]
		},

		{
			"name": "6. Targeted Push Notifications",
			"item": [
				{
					"name": "Send Targeted Push Notification",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"targetGroup\": [\"agent\", \"landLord\"],\n  \"title\": \"Important Policy Announcement\",\n  \"message\": \"Please update your listed property terms and verification details.\",\n  \"buildingId\": null\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/notifications/send",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "notifications", "send"]
						}
					}
				}
			]

{
	"info": {
		"_postman_id": "lagproperty-admin-collection-v1",
		"name": "LagProperty Admin APIs & RBAC Collection",
		"description": "Dedicated Postman Collection for LagProperty Admin APIs including Admin Account Creation, Role-Based Access Control (RBAC), Agent Blacklisting with recorded reasons, Analytics Dashboard (NIN transaction lookup, location housing stats), and User/Building Directory APIs.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Admin Account & RBAC Management",
			"item": [
				{
					"name": "Create Admin Account",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailAddress\": \"finance.admin@lagproperty.com\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"Finance\",\n  \"lastName\": \"Manager\",\n  \"role\": \"finance_admin\",\n  \"privilege\": \"financial_analytics,transactions,escrow\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/create",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "create"]
						},
						"description": "Create admin with specific role (super_admin, finance_admin, compliance_admin, property_admin, support_admin)."
					}
				},
				{
					"name": "Get All Admins (Paginated)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/list?page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "list"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					}
				},
				{
					"name": "Update Admin Role & Privileges",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"compliance_admin\",\n  \"privilege\": \"agent_blacklist,nin_lookup\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/1/role",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "1", "role"]
						}
					}
				},
				{
					"name": "Toggle Admin Account Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"disableAccount\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/1/status",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "1", "status"]
						}
					}
				}
			]
		},
